{
  "name": "ea-edge-agent",
  "version": "1.1.3",
  "description": "EA NITI Edge Agent - Offline Enterprise Architecture Review",
  "author": "EA NITI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:wasm": "cd src-rust && rustup run nightly wasm-pack build --target web --out-dir ../src/lib/wasm/pkg",
    "build:lexicon": "npx tsx scripts/compileLexicon.ts",
    "build:corpus": "npm run build:lexicon && npx tsx scripts/compileCorpus.ts",
    "build:training-corpus": "npx tsx scripts/exportSlmTrainingCorpus.ts",
    "build:brain-kb": "npx tsx scripts/exportBrainKb.ts",
    "validate:corpus": "npx tsx scripts/validateCorpus.ts",
    "verify:corpus": "node scripts/corpusArtifacts.mjs verify",
    "fetch:corpus": "node scripts/corpusArtifacts.mjs fetch",
    "unpack:corpus": "node scripts/corpusArtifacts.mjs unpack",
    "pack:corpus": "node scripts/corpusArtifacts.mjs pack",
    "generate:persona-inputs": "node scripts/generatePersonaCorpusInputs.mjs",
    "predev": "npm run verify:corpus",
    "dev": "vite",
    "prebuild": "npm run verify:corpus",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "pretest:e2e:sovereign": "node scripts/checkSovereignE2eModel.mjs",
    "test:e2e:sovereign": "playwright test src/__tests__/e2e/sovereign-local.spec.ts",
    "pretest:e2e:sovereign:headed": "node scripts/checkSovereignE2eModel.mjs",
    "test:e2e:sovereign:headed": "playwright test src/__tests__/e2e/sovereign-local.spec.ts --project=chromium --headed",
    "pretest:e2e:sovereign:chrome": "node scripts/checkSovereignE2eModel.mjs",
    "test:e2e:sovereign:chrome": "playwright test src/__tests__/e2e/sovereign-local.spec.ts --project=chrome --headed",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cleanup:test-files": "node remove-test-files.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "dompurify": "^3.4.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.453.0",
    "mermaid": "^11.3.0",
    "motion": "^12.38.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-select": "^5.10.2",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/html-to-text": "^9.0.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.5",
    "archiver": "^7.0.1",
    "compromise": "^14.15.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.9.0",
    "html-to-text": "^9.0.5",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.2.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^4.1.5"
  }
}
