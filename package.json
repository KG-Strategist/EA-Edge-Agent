{
  "name": "ea-edge-agent",
  "version": "1.1.4-beta",
  "description": "EA NITI Edge Agent - Offline Enterprise Architecture Review",
  "author": "EA NITI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:wasm": "cd src-rust && rustup run nightly wasm-pack build --target web --out-dir ../src/lib/wasm/pkg",
    "build:wasm:ocr": "cd src-rust/ocr && wasm-pack build --target web --out-dir ../../lib/wasm/ocr/pkg",
    "build:lexicon": "npx tsx scripts/compileLexicon.ts",
    "build:corpus": "npm run build:lexicon && npx tsx scripts/compileCorpus.ts",
    "build:training-corpus": "npx tsx scripts/exportSlmTrainingCorpus.ts",
    "build:brain-kb": "npx tsx scripts/exportBrainKb.ts",
    "validate:corpus": "npx tsx scripts/validateCorpus.ts",
    "verify:corpus": "node scripts/corpusArtifacts.mjs verify",
    "verify:ocr": "node scripts/ocrArtifacts.mjs verify",
    "fetch:corpus": "node scripts/corpusArtifacts.mjs fetch",
    "unpack:corpus": "node scripts/corpusArtifacts.mjs unpack",
    "pack:corpus": "node scripts/corpusArtifacts.mjs pack",
    "setup:local": "node scripts/setupLocal.mjs",
    "predev": "npm run verify:corpus && npm run verify:ocr",
    "dev": "vite",
    "dev:node22": "PATH=\"/opt/homebrew/Cellar/node@22/22.23.2/bin:$PATH\" npm run dev",
    "test:e2e:headed": "playwright test src/__tests__/e2e/regression/ --project=chromium --headed",
    "test:e2e:headed:chrome": "playwright test src/__tests__/e2e/regression/ --project=chrome --headed",
    "test:e2e:ucv": "playwright test src/__tests__/e2e/headed-ucv.spec.ts --project=chromium --headed",
    "harness:bugs": "node .opencode/harness/bug-harness/bug-runner.mjs",
    "harness:bugs:prod": "node .opencode/harness/bug-harness/bug-runner.mjs --target=prod",
    "harness:bugs:dev": "node .opencode/harness/bug-harness/bug-runner.mjs --target=dev",
    "harness:bug-loop": "node .opencode/harness/bug-harness/bug-loop.mjs",
    "prebuild": "npm run verify:corpus && npm run verify:ocr",
    "build": "node scripts/buildExcludeLarge.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "node scripts/audit-a11y.mjs",
    "test:e2e:sovereign": "npm run test:e2e:sovereign-smoke",
    "test:e2e:sovereign-smoke": "playwright test src/__tests__/e2e/sovereign-smoke.spec.ts --project=chromium",
    "pretest:e2e:sovereign-gguf": "node scripts/checkSovereignE2eModel.mjs",
    "test:e2e:sovereign-gguf": "playwright test src/__tests__/e2e/sovereign-local.spec.ts --project=chromium",
    "pretest:e2e:sovereign-gguf:headed": "node scripts/checkSovereignE2eModel.mjs",
    "test:e2e:sovereign-gguf:headed": "playwright test src/__tests__/e2e/sovereign-local.spec.ts --project=chromium --headed",
    "pretest:e2e:sovereign-gguf:chrome": "node scripts/checkSovereignE2eModel.mjs",
    "test:e2e:sovereign-gguf:chrome": "playwright test src/__tests__/e2e/sovereign-local.spec.ts --project=chrome --headed",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cleanup:test-files": "node remove-test-files.js",
    "harness:gate": "node .opencode/harness/gate-runner.mjs",
    "harness:gate:release": "node .opencode/harness/gate-runner.mjs --release",
    "harness:memory": "node .opencode/harness/repo-memory.mjs",
    "harness:loop": "node .opencode/harness/graph-loop.mjs",
    "harness:autonomous": "bash scripts/autonomous-loop.sh",
    "memory:context": "node .memory/scripts/context-loader.mjs",
    "memory:graph": "node .memory/scripts/context-loader.mjs --full"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "canvas": "^3.2.3",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "dompurify": "^3.4.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^0.453.0",
    "mermaid": "^11.3.0",
    "motion": "^12.38.0",
    "pdfjs-dist": "^5.6.205",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-select": "^5.10.2",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/html-to-text": "^9.0.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.5",
    "archiver": "^7.0.1",
    "compromise": "^14.15.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.9.0",
    "html-to-text": "^9.0.5",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.2.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "^0.20.5",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.5"
  }
}
